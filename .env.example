# Server-only variables. Never use a VITE_ prefix for DB credentials.
TURSO_DATABASE_URL=libsql://your-database-your-account.turso.io
TURSO_AUTH_TOKEN=replace-with-your-database-token
SITE_ORIGIN=https://www.wlss.re.kr

# Connect a PRIVATE Vercel Blob store. Server-only token; never use a VITE_ prefix.
BLOB_READ_WRITE_TOKEN=replace-with-your-private-blob-token
